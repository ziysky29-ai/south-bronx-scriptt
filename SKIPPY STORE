
-- SKIPPY STORE V3
-- Complete UI Demo
-- For Roblox Studio LocalScript

local Players = game:GetService("Players")
local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

local purple = Color3.fromRGB(168, 85, 247)
local dark = Color3.fromRGB(23, 18, 31)
local panel = Color3.fromRGB(38, 29, 49)
local white = Color3.fromRGB(245, 235, 255)
local green = Color3.fromRGB(150, 255, 180)
local red = Color3.fromRGB(255, 125, 150)

local old = playerGui:FindFirstChild("SkippyStore")
if old then old:Destroy() end

local gui = Instance.new("ScreenGui")
gui.Name = "SkippyStore"
gui.ResetOnSpawn = false
gui.Parent = playerGui

local main = Instance.new("Frame")
main.Size = UDim2.fromOffset(330, 330)
main.Position = UDim2.new(0.5, -165, 0.5, -165)
main.BackgroundColor3 = dark
main.BorderSizePixel = 0
main.Parent = gui

Instance.new("UICorner", main).CornerRadius =
    UDim.new(0, 14)

local outline = Instance.new("UIStroke", main)
outline.Color = purple
outline.Thickness = 2

local header = Instance.new("Frame")
header.Size = UDim2.new(1, 0, 0, 55)
header.BackgroundColor3 = panel
header.BorderSizePixel = 0
header.Parent = main

Instance.new("UICorner", header).CornerRadius =
    UDim.new(0, 12)

local function label(text, position, size, color)
    local obj = Instance.new("TextLabel")
    obj.Size = size
    obj.Position = position
    obj.BackgroundTransparency = 1
    obj.Text = text
    obj.TextColor3 = color or white
    obj.Font = Enum.Font.GothamBold
    obj.TextSize = 13
    obj.TextXAlignment = Enum.TextXAlignment.Left
    obj.Parent = main
    return obj
end

local title = Instance.new("TextLabel")
title.Size = UDim2.new(1, -60, 1, 0)
title.Position = UDim2.fromOffset(15, 0)
title.BackgroundTransparency = 1
title.Text = "SKIPPY STORE"
title.TextColor3 = purple
title.Font = Enum.Font.GothamBold
title.TextSize = 22
title.TextXAlignment = Enum.TextXAlignment.Left
title.Parent = header

local close = Instance.new("TextButton")
close.Size = UDim2.fromOffset(34, 32)
close.Position = UDim2.new(1, -44, 0, 11)
close.BackgroundColor3 = Color3.fromRGB(90, 40, 110)
close.Text = "X"
close.TextColor3 = white
close.Font = Enum.Font.GothamBold
close.TextSize = 16
close.Parent = header
Instance.new("UICorner", close).CornerRadius =
    UDim.new(0, 8)

label("SOUTH BRONX | CUSTOM UI",
    UDim2.fromOffset(15, 65),
    UDim2.new(1, -30, 0, 22),
    Color3.fromRGB(185, 160, 205))

local status = label("STATUS: STOPPED",
    UDim2.fromOffset(15, 91),
    UDim2.new(1, -30, 0, 35), red)
status.TextWrapped = true

local function makeButton(text, y)
    local b = Instance.new("TextButton")
    b.Size = UDim2.new(1, -30, 0, 39)
    b.Position = UDim2.fromOffset(15, y)
    b.BackgroundColor3 = panel
    b.Text = text
    b.TextColor3 = white
    b.Font = Enum.Font.GothamSemibold
    b.TextSize = 14
    b.Parent = main

    Instance.new("UICorner", b).CornerRadius =
        UDim.new(0, 9)

    local s = Instance.new("UIStroke", b)
    s.Color = purple
    s.Transparency = 0.4

    return b
end

local fullyButton = makeButton("MS AUTO FULLY", 133)
local farmButton = makeButton("AUTO FARM", 180)
local startButton = makeButton("START", 227)

local mode = "MS AUTO FULLY"
local running = false

fullyButton.Activated:Connect(function()
    mode = "MS AUTO FULLY"
    status.Text = "MODE: MS AUTO FULLY"
    status.TextColor3 = purple
end)

farmButton.Activated:Connect(function()
    mode = "AUTO FARM"
    status.Text = "MODE: AUTO FARM"
    status.TextColor3 = purple
end)

startButton.Activated:Connect(function()
    running = not running

    if running then
        startButton.Text = "STOP"
        startButton.BackgroundColor3 =
            Color3.fromRGB(100, 40, 120)
        status.Text = mode .. " - RUNNING"
        status.TextColor3 = green
    else
        startButton.Text = "START"
        startButton.BackgroundColor3 = panel
        status.Text = "STATUS: STOPPED"
        status.TextColor3 = red
    end
end)

close.Activated:Connect(function()
    running = false
    gui:Destroy()
end)

print("Skippy Store V3 loaded successfully")
