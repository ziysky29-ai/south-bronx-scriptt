
-- SKIPPY STORE | Custom Roblox UI
-- Visual demo only

local Players = game:GetService("Players")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

local purple = Color3.fromRGB(168, 85, 247)
local dark = Color3.fromRGB(23, 18, 31)
local panel = Color3.fromRGB(38, 29, 49)
local white = Color3.fromRGB(245, 235, 255)

local gui = Instance.new("ScreenGui")
gui.Name = "SkippyStore"
gui.ResetOnSpawn = false
gui.Parent = playerGui

local main = Instance.new("Frame")
main.Name = "Main"
main.Size = UDim2.fromOffset(330, 300)
main.Position = UDim2.new(0.5, -165, 0.5, -150)
main.BackgroundColor3 = dark
main.BorderSizePixel = 0
main.Parent = gui

Instance.new("UICorner", main).CornerRadius =
    UDim.new(0, 14)

local stroke = Instance.new("UIStroke")
stroke.Color = purple
stroke.Thickness = 2
stroke.Parent = main

local header = Instance.new("Frame")
header.Name = "Header"
header.Size = UDim2.new(1, 0, 0, 55)
header.BackgroundColor3 = panel
header.BorderSizePixel = 0
header.Parent = main

Instance.new("UICorner", header).CornerRadius =
    UDim.new(0, 12)

local title = Instance.new("TextLabel")
title.Size = UDim2.new(1, -65, 1, 0)
title.Position = UDim2.fromOffset(15, 0)
title.BackgroundTransparency = 1
title.Text = "SKIPPY STORE"
title.TextColor3 = purple
title.Font = Enum.Font.GothamBold
title.TextSize = 22
title.TextXAlignment = Enum.TextXAlignment.Left
title.Parent = header

local close = Instance.new("TextButton")
close.Size = UDim2.fromOffset(34, 32)
close.Position = UDim2.new(1, -44, 0, 11)
close.BackgroundColor3 = Color3.fromRGB(90, 40, 110)
close.Text = "X"
close.TextColor3 = white
close.Font = Enum.Font.GothamBold
close.TextSize = 16
close.Parent = header

Instance.new("UICorner", close).CornerRadius =
    UDim.new(0, 8)

local subtitle = Instance.new("TextLabel")
subtitle.Size = UDim2.new(1, -30, 0, 22)
subtitle.Position = UDim2.fromOffset(15, 65)
subtitle.BackgroundTransparency = 1
subtitle.Text = "SOUTH BRONX | CUSTOM UI"
subtitle.TextColor3 = Color3.fromRGB(185, 160, 205)
subtitle.Font = Enum.Font.Gotham
subtitle.TextSize = 11
subtitle.TextXAlignment = Enum.TextXAlignment.Left
subtitle.Parent = main

local status = Instance.new("TextLabel")
status.Size = UDim2.new(1, -30, 0, 25)
status.Position = UDim2.fromOffset(15, 91)
status.BackgroundTransparency = 1
status.Text = "STATUS: STOPPED"
status.TextColor3 = Color3.fromRGB(255, 125, 150)
status.Font = Enum.Font.GothamBold
status.TextSize = 12
status.TextXAlignment = Enum.TextXAlignment.Left
status.Parent = main

local function makeButton(text, y)
    local button = Instance.new("TextButton")
    button.Size = UDim2.new(1, -30, 0, 39)
    button.Position = UDim2.fromOffset(15, y)
    button.BackgroundColor3 = panel
    button.Text = text
    button.TextColor3 = white
    button.Font = Enum.Font.GothamSemibold
    button.TextSize = 14
    button.Parent = main

    Instance.new("UICorner", button).CornerRadius =
        UDim.new(0, 9)

    local outline = Instance.new("UIStroke")
    outline.Color = purple
    outline.Thickness = 1
    outline.Transparency = 0.45
    outline.Parent = button

    return button
end

local fullyButton = makeButton("MS AUTO FULLY", 125)
local farmButton = makeButton("AUTO FARM", 173)
local startButton = makeButton("START", 221)

fullyButton.Activated:Connect(function()
    status.Text = "MODE: MS AUTO FULLY (DEMO)"
    status.TextColor3 = purple
end)

farmButton.Activated:Connect(function()
    status.Text = "MODE: AUTO FARM (DEMO)"
    status.TextColor3 = purple
end)

local running = false

startButton.Activated:Connect(function()
    running = not running

    if running then
        startButton.Text = "STOP"
        startButton.BackgroundColor3 =
            Color3.fromRGB(100, 40, 120)
        status.Text = "STATUS: UI STARTED"
        status.TextColor3 =
            Color3.fromRGB(190, 255, 190)
    else
        startButton.Text = "START"
        startButton.BackgroundColor3 = panel
        status.Text = "STATUS: STOPPED"
        status.TextColor3 =
            Color3.fromRGB(255, 125, 150)
    end
end)

close.Activated:Connect(function()
    gui:Destroy()
end)

print("Skippy Store UI loaded successfully")
